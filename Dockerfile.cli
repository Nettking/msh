FROM python:3.12-slim

ARG MSH_BUILD_COMMIT=unknown
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MPLBACKEND=Agg \
    MSH_BUILD_COMMIT=${MSH_BUILD_COMMIT}
LABEL no.msh.build_commit=${MSH_BUILD_COMMIT}

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY . /app

ENTRYPOINT ["python", "-m", "catalog.orchestrator.cli"]
