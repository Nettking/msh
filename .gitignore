# Data and generated artifacts
/data_old
/graphs
/plots
/plots_per_machine
/data.zip
*.csv
*.png
/graphify-out/

# Keep the canonical data directory documented, but ignore its contents by default
/data/*
!/data/README.md
!/data/.gitkeep

# Optional shared results area (documentation tracked, generated files ignored)
/results/*
!/results/README.md
!/results/.gitkeep

# CF7 physical acceptance is local and may contain redacted operational evidence.
# Never commit raw endpoints, screenshots, logs, topology choices or evidence files.
/evidence/
/cf7-physical.local.json
/cf7-topology.local.json

