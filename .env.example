# Copy to .env or run: python setup_msh.py
# Docker Compose reads this file automatically when it is named .env.

# Profiles:
# full = Flask workbench plus MTConnect recorder
# web = Flask workbench only
# recorder = MTConnect recorder only
# prep = one-shot preparation
# observer-sync = one-shot Observer Phoenix synchronization
COMPOSE_PROFILES=full
MSH_DEPLOYMENT_MODE=full-server

# Server binding. Use 0.0.0.0 so other computers on the LAN can connect.
MSH_WEB_BIND=0.0.0.0
MSH_WEB_PORT=5000
MSH_FLASK_SECRET=msh-dev-change-me
MSH_SCAN_DIRS=results,data
MSH_SKIP_ORCHESTRATION=0

# Optional recorder configuration. Leave empty to use built-in lab defaults.
# Format: MachineName=http://host:port/current;OtherMachine=http://host:port/current
MSH_RECORDER_SOURCES=
MSH_RECORDER_DATA_DIR=data
MSH_RECORDER_STATE_FILE=data/source_state/mtconnect_recorder_state.json
MSH_RECORDER_POLL_INTERVAL=0.2
MSH_RECORDER_FLUSH_INTERVAL=1.0
MSH_RECORDER_REQUEST_TIMEOUT=1.0
MSH_RECORDER_INCLUDE_CONDITION=false
