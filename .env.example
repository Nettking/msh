# Copy to .env or run: python setup_fcp.py
# Docker Compose reads this file automatically when it is named .env.

# Profiles:
# full = Flask workbench plus MTConnect recorder
# web = Flask workbench only
# recorder = MTConnect recorder only
# prep = one-shot preparation
# observer-sync = one-shot Observer Phoenix synchronization
# ai = local Ollama model server and model installer for /ai
COMPOSE_PROFILES=full,ai
FCP_DEPLOYMENT_MODE=full-server

# Web host publication is loopback-only by default. Set a trusted LAN/VPN
# interface explicitly only when another device must reach the workbench.
FCP_WEB_BIND=127.0.0.1
FCP_WEB_PORT=5000
# The Federation relay is host-loopback by default. Expose it only when
# another trusted LAN/VPN device must pair; never publish it to the Internet.
FCP_RELAY_BIND=127.0.0.1
FCP_RELAY_PORT=8765
# Human web authentication. On first production start FCP creates independent,
# persistent session/password secrets under FCP_AUTH_SECRET_DIR when these are blank.
# Supplying explicit values is supported; each must be at least 32 characters.
FCP_FLASK_SECRET=
FCP_PASSWORD_SALT=
FCP_AUTH_DATABASE=data/auth/users.sqlite3
FCP_AUTH_SECRET_DIR=data/auth
# Set when TLS terminates at Flask (or forwarded HTTPS is trusted/configured).
FCP_HTTPS=0
# Only for an explicitly local development process; never use in deployment.
FCP_DEVELOPMENT=0
FCP_SCAN_DIRS=results,data
FCP_SKIP_ORCHESTRATION=0

# Local AI explainer. setup_fcp.py offers three standard choices:
# edge-small -> smollm2:360m
# laptop-standard -> llama3.2:3b
# workstation-strong -> qwen2.5:7b
FCP_AI_PROFILE=laptop-standard
FCP_AI_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://ollama:11434

# Optional loss-aware MTConnect recorder configuration.
# Agent root URLs are preferred, but /current, /sample, and /probe URLs are accepted.
# Format: MachineName=http://host:port;OtherMachine=http://host:port
FCP_RECORDER_SOURCES=
FCP_RECORDER_DATA_DIR=data
FCP_RECORDER_STATE_FILE=data/source_state/mtconnect_recorder_state.json
FCP_RECORDER_POLL_INTERVAL=0.2
FCP_RECORDER_REQUEST_TIMEOUT=10.0
FCP_RECORDER_BATCH_SIZE=1000
FCP_RECORDER_MAX_BATCHES_PER_CYCLE=20
# Optional logical-storage group when the Federation exposes more than one.
FCP_RECORDER_STORAGE_GROUP=
# Verified local mirror consumed by the workbench. Keep it inside the mounted
# data root unless FCP_SCAN_DIRS also includes the chosen parent directory.
FCP_FEDERATED_TELEMETRY_MIRROR_DIR=data/federation/shared
FCP_FEDERATED_TELEMETRY_MAX_PAGES_PER_SYNC=5
FCP_FEDERATED_TELEMETRY_MAX_BATCHES_PER_SYNC=100
# Conditions are always captured; the old include-condition setting is ignored.

# Logical-storage authority. A Federation cannot accept published recorder or
# JSONL data unless the device that created it serves this authority. It is off
# by default so a device never opens an authority connection it was not asked to
# provide, and it only works on the session creator: a publisher accepts the
# storage capability from that node alone.
FCP_FEDERATION_STORAGE_AUTHORITY_ENABLED=0
# Falls back to FCP_PAIRING_RELAY_URL when left blank.
FCP_FEDERATION_STORAGE_AUTHORITY_RELAY=
FCP_FEDERATION_STORAGE_AUTHORITY_DIR=data/federation/storage
